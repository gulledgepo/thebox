@inject PlayerStatsModel PlayerStats
@implements IDisposable

@if (_flashActive)
{
    <div class="sacrifice-flash"></div>
}

@if (IsVisible)
{
    <div class="sacrifice-overlay">
        <button class="sacrifice-life-btn" @onclick="DoSacrifice">
            S A C R I F I C E
        </button>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnSacrificePerformed { get; set; }

    private bool _flashActive = false;

    private async void DoSacrifice()
    {
        PlayerStats.PerformSacrifice();

        // Trigger screen flash
        _flashActive = true;
        StateHasChanged();

        // Notify parent to trigger whisper burst
        await OnSacrificePerformed.InvokeAsync();

        // Remove flash after animation completes
        await Task.Delay(800);
        _flashActive = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() { }
}
