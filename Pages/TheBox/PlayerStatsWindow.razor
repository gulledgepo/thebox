@inject PlayerStatsModel PlayerStats
@implements IDisposable

<div class="player-stats">
    <div class="player-stat-row">
        <span>Piety: @PlayerStats.Piety</span>
        <button class="sacrifice-btn"
                @onclick="SacrificeForPiety">
            @NumberFormat.Abbreviate(PlayerStats.PietyCost)
        </button>
    </div>
    @if (PlayerStats.HasUnlockedZeal)
    {
        <div class="player-stat-row">
            <span>Zeal: @PlayerStats.Zeal</span>
            <button class="sacrifice-btn"
                    @onclick="SacrificeForZeal">
                @NumberFormat.Abbreviate(PlayerStats.ZealCost)
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        PlayerStats.OnChange += OnStateChanged;
    }

    private void SacrificeForPiety()
    {
        PlayerStats.SacrificeForPiety();
    }

    private void SacrificeForZeal()
    {
        PlayerStats.SacrificeForZeal();
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PlayerStats.OnChange -= OnStateChanged;
    }
}
