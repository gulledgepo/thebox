@implements IDisposable

<div class="click-whispers" @onclick:stopPropagation="false">
    @foreach (var whisper in _active)
    {
        <span @key="whisper.Id" class="whisper whisper-@(whisper.Style) @(EnableGlow ? whisper.GlowClass : "") @(EnableUnevenText ? "whisper-uneven" : "")"
              style="left:@(whisper.X)vw; top:@(whisper.Y)vh; --whisper-rot:@(whisper.Rotation)deg; font-size:@(whisper.Size)rem">
            @if (EnableUnevenText && whisper.UnevenOffsets.Length > 0)
            {
                @foreach (var (ch, offset) in whisper.TextChars.Zip(whisper.UnevenOffsets))
                {
                    <span style="opacity:@(offset.Opacity.ToString("F2")); font-size:@(offset.Scale.ToString("F2"))em; transform:translateY(@(offset.YShift.ToString("F1"))px)">@ch</span>
                }
            }
            else
            {
                @whisper.Text
            }
        </span>
    }
</div>

@code {
    // Toggle these to enable/disable effects
    public bool EnableGlow { get; set; } = true;
    public bool EnableUnevenText { get; set; } = true;

    [Parameter] public double HpPercent { get; set; } = 1.0;
    [Parameter] public bool HpBarVisible { get; set; } = false;

    // Safe spawn zones (vw/vh percentages)
    // Box occupies ~35-65vw, ~28-62vh (centered in 80vh container)
    // Zone 4 (above box) uses y=6 to clear the HP bar when visible
    private static readonly (int MinX, int MaxX, int MinY, int MaxY)[] SpawnZones = {
        (2,  40, 8,  45),   // 0 - left,  upper
        (60, 96, 8,  45),   // 1 - right, upper
        (2,  38, 55, 80),   // 2 - left,  lower
        (62, 96, 55, 80),   // 3 - right, lower
        (15, 85, 6,  27),   // 4 - above box (always active, y=6 clears HP bar)
    };

    private readonly List<WhisperData> _active = new();
    private readonly Random _rng = new();
    private int _clickCount = 0;
    private int _nextId = 0;

    // Side-balance tracking: left=zones 0,2  right=zones 1,3  center=zone 4
    private string _lastSide = "";
    private int _consecutiveSideCount = 0;
    // Alternating extra for desperate zone
    private bool _desperateExtra = false;

    public void OnClick()
    {
        _clickCount++;
        int every = GetClicksPerWhisper();
        if (_clickCount % every != 0) return;
        SpawnWhisper();
    }

    // At full HP: every 3 clicks. Desperate zone: every 2. Dark/critical: every click.
    private int GetClicksPerWhisper()
    {
        if (!HpBarVisible || HpPercent >= 0.65) return 3;
        if (HpPercent >= 0.30) return 2;
        return 1;
    }

    public void OnPassiveTick()
    {
        int count = GetPassiveSpawnCount();
        for (int i = 0; i < count; i++)
            SpawnWhisper();
    }

    // Full HP: 1. Desperate: mostly 2, sometimes 1. Dark/critical: 3.
    private int GetPassiveSpawnCount()
    {
        if (!HpBarVisible || HpPercent >= 0.65) return 1;
        if (HpPercent >= 0.30)
        {
            _desperateExtra = !_desperateExtra;
            return _desperateExtra ? 2 : 1;
        }
        // Critical: 3 at a time for that overwhelming feel
        return 3;
    }

    private static string ZoneSide(int index) => index switch
    {
        0 or 2 => "left",
        1 or 3 => "right",
        _      => "center"
    };

    private int PickZoneIndex()
    {
        // If we've sent 2 in a row to the same side, exclude it from candidates
        if (_consecutiveSideCount >= 2 && (_lastSide == "left" || _lastSide == "right"))
        {
            var candidates = Enumerable.Range(0, SpawnZones.Length)
                .Where(i => ZoneSide(i) != _lastSide)
                .ToArray();
            return candidates[_rng.Next(candidates.Length)];
        }

        return _rng.Next(SpawnZones.Length);
    }

    private void SpawnWhisper()
    {
        int zoneIdx = PickZoneIndex();
        string side = ZoneSide(zoneIdx);

        // Update side streak tracking
        if (side == _lastSide)
            _consecutiveSideCount++;
        else
        {
            _lastSide = side;
            _consecutiveSideCount = 1;
        }

        var zone = SpawnZones[zoneIdx];
        var styleIndex = _rng.Next(6);
        var text = GetVariant();
        var glowClasses = new[] { "", "", "", "whisper-glow", "whisper-ghost", "whisper-sharp-glow" };
        var whisper = new WhisperData
        {
            Id = _nextId++,
            Text = text,
            X = _rng.Next(zone.MinX, zone.MaxX),
            Y = _rng.Next(zone.MinY, zone.MaxY),
            Rotation = _rng.Next(-12, 13),
            Size = 0.7 + _rng.NextDouble() * 0.6,
            Style = styleIndex,
            GlowClass = glowClasses[_rng.Next(glowClasses.Length)],
            UnevenOffsets = _rng.Next(5) == 0 ? GenerateUnevenOffsets(text.Length) : Array.Empty<UnevenOffset>()
        };

        _active.Add(whisper);
        StateHasChanged();

        _ = RemoveAfterDelay(whisper.Id);
    }

    // Each entry is (text, weight). Higher weight = more common.
    // Common variants ~10, uncommon ~3, rare ~1
    private static readonly (string Text, int Weight)[] Variants = {
        ("i love you",      10),
        ("I LOVE YOU",       8),
        ("I Love You",       8),
        ("i Love you",       6),
        ("i love YOU",       6),
        ("I love you",       8),
        ("i LOVE you",       6),
        ("i love you...",    5),
        ("I love you.",      5),
        (".uoy evol i",      3),
        ("je t'aime",        2),
        ("te amo",           2),
        ("ich liebe dich",   1),
        ("愛してる",           1),
        ("사랑해",             1),
        ("я тебя люблю",     1),
        ("σ'αγαπώ",          1),
        ("ti amo",           2),
    };

    private static readonly int TotalWeight = Variants.Sum(v => v.Weight);

    private static readonly (string Text, int Weight)[] DesperateVariants = {
        ("why don't you love me",   8),
        ("please don't leave",      8),
        ("what did I do wrong",     6),
        ("come back",               5),
        ("i need you",              7),
        ("don't go",                6),
        ("was it something i said", 4),
        ("i'll do anything",        5),
        ("please...",               3),
    };

    private static readonly int DesperateTotalWeight = DesperateVariants.Sum(v => v.Weight);

    private static readonly (string Text, int Weight)[] DarkVariants = {
        ("SACRIFICE",               8),
        ("feed me",                 7),
        ("they must pay",           6),
        ("GIVE THEM TO ME",         5),
        ("blood for blood",         4),
        ("it hungers",              5),
        ("you owe me",              6),
        ("OBEY",                    3),
    };

    private static readonly int DarkTotalWeight = DarkVariants.Sum(v => v.Weight);

    // Thresholds matching LifeForceParams defaults
    private const double DesperateStart = 0.65;
    private const double DarkStart = 0.30;

    private string GetVariant()
    {
        if (!HpBarVisible || HpPercent >= DesperateStart)
            return PickFromPool(Variants, TotalWeight);

        if (HpPercent > DarkStart)
        {
            // Blend love -> desperate
            double t = (DesperateStart - HpPercent) / (DesperateStart - DarkStart);
            return _rng.NextDouble() < t
                ? PickFromPool(DesperateVariants, DesperateTotalWeight)
                : PickFromPool(Variants, TotalWeight);
        }

        // Blend desperate -> dark
        double d = DarkStart > 0 ? (DarkStart - HpPercent) / DarkStart : 1.0;
        return _rng.NextDouble() < d
            ? PickFromPool(DarkVariants, DarkTotalWeight)
            : PickFromPool(DesperateVariants, DesperateTotalWeight);
    }

    private string PickFromPool((string Text, int Weight)[] pool, int totalWeight)
    {
        var roll = _rng.Next(totalWeight);
        var cumulative = 0;
        foreach (var (text, weight) in pool)
        {
            cumulative += weight;
            if (roll < cumulative)
                return text;
        }
        return pool[0].Text;
    }

    private async Task RemoveAfterDelay(int id)
    {
        await Task.Delay(2500);
        _active.RemoveAll(w => w.Id == id);
        await InvokeAsync(StateHasChanged);
    }

    private UnevenOffset[] GenerateUnevenOffsets(int length)
    {
        var offsets = new UnevenOffset[length];
        for (int i = 0; i < length; i++)
        {
            offsets[i] = new UnevenOffset
            {
                Opacity = 0.7 + _rng.NextDouble() * 0.3,   // 0.7 to 1.0
                Scale = 0.85 + _rng.NextDouble() * 0.3,     // 0.85 to 1.15
                YShift = (_rng.NextDouble() - 0.5) * 3.0    // -1.5px to +1.5px
            };
        }
        return offsets;
    }

    public void Dispose() { }

    private struct UnevenOffset
    {
        public double Opacity;
        public double Scale;
        public double YShift;
    }

    private class WhisperData
    {
        public int Id;
        public string Text = "";
        public int X;
        public int Y;
        public int Rotation;
        public double Size;
        public int Style;
        public string GlowClass = "";
        public UnevenOffset[] UnevenOffsets = Array.Empty<UnevenOffset>();
        public char[] TextChars => Text.ToCharArray();
    }
}
